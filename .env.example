# Copy to .env — .env is gitignored and never leaves this machine.

# ---- Claude agent (Milestone 5) ----
# Required only for the Agent panel. Everything else works without it.
ANTHROPIC_API_KEY=

# Model used by the agent loop.
CLOUDATLAS_MODEL=claude-sonnet-5

# ---- Provider ----
# "live" scans AWS with your local credentials; "demo" uses the bundled fixture account.
CLOUDATLAS_PROVIDER=demo

# ---- Server ----
# The backend binds to 127.0.0.1 only. Port is for the local API.
CLOUDATLAS_PORT=5174
CLOUDATLAS_LOG_LEVEL=info
